# Multi-stage build for The Look Android APK
FROM ubuntu:22.04 as android-builder

# Set environment variables
ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    PATH=$PATH:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools \
    JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64 \
    DEBIAN_FRONTEND=noninteractive

# Install dependencies
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    unzip \
    openjdk-21-jdk \
    nodejs \
    npm \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install pnpm
RUN npm install -g pnpm@10.4.1

# Install Android SDK
RUN mkdir -p ${ANDROID_HOME}/cmdline-tools && \
    cd ${ANDROID_HOME}/cmdline-tools && \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-9477386_latest.zip && \
    unzip -q commandlinetools-linux-9477386_latest.zip && \
    rm commandlinetools-linux-9477386_latest.zip && \
    mv cmdline-tools latest

# Install Android SDK components
RUN yes | sdkmanager --licenses && \
    sdkmanager \
    "platforms;android-34" \
    "build-tools;34.0.0"

# Create app directory
WORKDIR /app

# Copy project files
COPY . .

# Install dependencies with --no-frozen-lockfile to avoid lock file issues
RUN pnpm install --no-frozen-lockfile || npm install

# Build web app
RUN pnpm build || npm run build

# Sync Capacitor to Android
RUN npx cap sync android

# Build APK
RUN cd android && \
    chmod +x gradlew && \
    ./gradlew assembleDebug --no-daemon && \
    cd ..

# Stage 2: Output stage
FROM scratch

COPY --from=android-builder /app/android/app/build/outputs/apk/debug/app-debug.apk /the-look.apk

# Export APK as artifact
ENTRYPOINT ["cat", "/the-look.apk"]
